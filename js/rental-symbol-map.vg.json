          "type": "topojson",
          "feature": "victoria_view"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e8e8",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/australia-states.topojson",
        "format": {
          "type": "topojson",
          "feature": "rental_regions"
        }
      },
      "transform": [
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "lon"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "lat"
        },
        {
          "calculate": "datum.properties.name",
          "as": "region"
        },
        {
          "calculate": "datum.properties.house_rent",
          "as": "house"
        },
        {
          "calculate": "datum.properties.unit_rent",
          "as": "unit"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#8a4f7d",
        "fillOpacity": 0.12,
        "stroke": "#8a4f7d",
        "strokeWidth": 2.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "house",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              700
            ],
            "range": [
              0,
              1800
            ],
            "zero": true
          },
          "legend": null
        },
        "tooltip": [
